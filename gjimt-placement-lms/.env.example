# Firebase Web App config
# Get these values from Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Demo credentials (the same values are shown on the login page for local demo mode).
# After Firebase is enabled, create this user in Authentication -> Users.
VITE_DEMO_EMAIL=demo.placement@gjimt.ac.in
VITE_DEMO_PASSWORD=GJIMT@2026!
